{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["index.ts", "render.ts", "graph.ts", "priority.ts", "lease.ts", "lock.ts", "boot.ts", "restore.ts"]
}
