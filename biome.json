{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"recommended": true,
			"performance": {
				"noDelete": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"files": {
		"includes": ["**", "!**/.git", "!**/node_modules", "!**/coverage", "!**/reports"]
	}
}
